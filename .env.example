# Hydromancer market-wide allFills WebSocket
HYDROMANCER_API_KEY=
# Case-sensitive protocol coin names. One allFills subscription uses this full list.
HYDROMANCER_COINS=BTC,ETH
HYDROMANCER_RECONNECT_DELAY_SECONDS=1

# Postgres / TimescaleDB
PG_DSN=postgresql://postgres:postgres@localhost:5432/hydromancer
PG_SCHEMA=public

# Labeling controls (labels run on this bounded cadence, not per frame)
LABEL_MARKOUT_HORIZON_SECONDS=60
LABEL_AGG_WINDOW_HOURS=24
LABEL_INTERVAL_SECONDS=60
