# Hydromancer market-wide streams
HYDROMANCER_API_KEY=
# Case-sensitive full market names, for example BTC or xyz:KORU.
HYDROMANCER_COINS=BTC,ETH
HYDROMANCER_RECONNECT_DELAY_SECONDS=1
# Log replay status periodically and reconnect if no chunk advances within this window.
HYDROMANCER_REPLAY_STATUS_INTERVAL_SECONDS=5
HYDROMANCER_REPLAY_STALL_TIMEOUT_SECONDS=30

# PostgreSQL / TimescaleDB
PG_DSN=postgresql://postgres:postgres@localhost:5432/hydromancer

# Toxic-flow labeling and bounded raw market-data retention
LABEL_INTERVAL_SECONDS=3600
L2_VOLATILITY_LOOKBACK=1000
L2_VOLATILITY_MIN_SAMPLES=20
L2_RETENTION_HOURS=168
L4_RETENTION_HOURS=24
